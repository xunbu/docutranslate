# ============================================================
# DocuTranslate 环境变量配置示例
# 复制此文件为 .env 并取消注释需要修改的配置
#
# 这些环境变量设置后端参数的默认值
# 当前端/API调用没有传参时，才使用这些默认值
# ============================================================

# -----------------------------------------------------------
# 环境变量默认值模式
# -----------------------------------------------------------
# 是否跳过前端空值检查（仅影响 Web 前端）
# 设为 true 时，Web 前端跳过空值检查，使用后端 .env 的默认值，并在页面显示提示图标
# DOCUTRANSLATE_WEB_SKIP_VALIDATION=false
# 是否强制使用环境变量的值
# 设为 true 时，如果 .env 中设置了某个字段，则强制使用该值，忽略前端传参
# 设为 false 时，仅当前端传参为空时才使用 .env 中的值（默认行为）
# DOCUTRANSLATE_ENV_FORCE_OVERRIDE=false

# -----------------------------------------------------------
# LLM 基础配置
# -----------------------------------------------------------
# API 密钥
# DOCUTRANSLATE_API_KEY=sk-xxxxxxxx
# API 基础 URL
# DOCUTRANSLATE_BASE_URL=https://api.openai.com/v1
# 模型 ID
# DOCUTRANSLATE_MODEL_ID=gpt-4o
# LLM 供应商标识：default, google, minimax, ollama, aliyuncs, volces, siliconflow, bigmodel, deepseek, openrouter, mimo, litellm
# DOCUTRANSLATE_PROVIDER=default
# 目标语言
# DOCUTRANSLATE_TO_LANG=中文

# -----------------------------------------------------------
# LLM 高级参数
# -----------------------------------------------------------
# 思考模式：default, enable, disable
# DOCUTRANSLATE_THINKING=disable
# 文本分块大小
# DOCUTRANSLATE_CHUNK_SIZE=4000
# 并发请求数
# DOCUTRANSLATE_CONCURRENT=30
# 温度参数
# DOCUTRANSLATE_TEMPERATURE=0.7
# Top-P 参数
# DOCUTRANSLATE_TOP_P=0.9
# 是否使用 LLM 流式响应。默认 true。
# DOCUTRANSLATE_LLM_STREAMING=true
# 流式响应连续无任何原始数据/心跳的超时（秒）。默认 300。
# 每收到数据就重新计时；流式模式不设置总墙钟上限。
# DOCUTRANSLATE_STREAM_IDLE_TIMEOUT=300
# 非流式单个请求/分片的硬总超时（秒）。
# 未设置时沿用 DOCUTRANSLATE_TIMEOUT，以兼容旧配置。
# DOCUTRANSLATE_NON_STREAM_TIMEOUT=1200
# 旧版总超时配置；现在仅作为非流式硬总超时的兼容默认值。
# DOCUTRANSLATE_TIMEOUT=1200
# 每次建立 TCP/TLS 连接的超时时间（秒）
# DOCUTRANSLATE_CONNECT_TIMEOUT=5
# 非流式两次网络读取之间允许的最大静默时间（秒）
# DOCUTRANSLATE_READ_TIMEOUT=1200
# 单次网络写入操作的超时时间（秒）
# DOCUTRANSLATE_WRITE_TIMEOUT=300
# 等待 HTTP 连接池空闲连接的超时时间（秒）
# DOCUTRANSLATE_POOL_TIMEOUT=10
# 重试次数
# DOCUTRANSLATE_RETRY=2
# 是否使用系统代理
# DOCUTRANSLATE_SYSTEM_PROXY_ENABLE=false
# 强制 JSON 输出
# DOCUTRANSLATE_FORCE_JSON=false
# RPM 限制
# DOCUTRANSLATE_RPM=
# TPM 限制
# DOCUTRANSLATE_TPM=
# 自定义提示词
# DOCUTRANSLATE_CUSTOM_PROMPT=
# 额外请求体 JSON
# DOCUTRANSLATE_EXTRA_BODY=
# 是否启用术语表自动生成
# DOCUTRANSLATE_GLOSSARY_GENERATE_ENABLE=false

# -----------------------------------------------------------
# Markdown 工作流配置
# -----------------------------------------------------------
# PDF 转换引擎：identity, mineru, mineru_deploy
# DOCUTRANSLATE_CONVERT_ENGINE=identity
# Markdown 转 DOCX 引擎：python, pandoc, auto
# DOCUTRANSLATE_MD2DOCX_ENGINE=auto

# -----------------------------------------------------------
# MinerU Cloud 配置（convert_engine=mineru 时使用）
# -----------------------------------------------------------
# MinerU API Token
# DOCUTRANSLATE_MINERU_TOKEN=
# MinerU 模型版本：pipeline, vlm
# DOCUTRANSLATE_MODEL_VERSION=vlm
# 是否启用公式 OCR
# DOCUTRANSLATE_FORMULA_OCR=true
# MinerU 语言：ch, en, japan 等
# DOCUTRANSLATE_MINERU_LANGUAGE=ch
# MinerU Cloud HTTP 分阶段超时（秒）
# DOCUTRANSLATE_MINERU_CONNECT_TIMEOUT=5
# DOCUTRANSLATE_MINERU_READ_TIMEOUT=600
# DOCUTRANSLATE_MINERU_WRITE_TIMEOUT=600
# DOCUTRANSLATE_MINERU_POOL_TIMEOUT=1

# -----------------------------------------------------------
# MinerU Deploy 配置（convert_engine=mineru_deploy 时使用）
# -----------------------------------------------------------
# 本地部署地址
# DOCUTRANSLATE_MINERU_DEPLOY_BASE_URL=http://127.0.0.1:8000
# 本地解析服务的可选鉴权密钥（不是在线 MinerU Token 或翻译模型 API Key）
# 前端及接口的 mineru_deploy_api_key 留空时使用此值；显式传值优先。
# 启用 DOCUTRANSLATE_ENV_FORCE_OVERRIDE 且此变量已设置时，强制使用环境变量值。
# DOCUTRANSLATE_MINERU_DEPLOY_API_KEY=
# 部署后端：hybrid-engine, vlm-engine, pipeline, vlm-http-client, hybrid-http-client
# DOCUTRANSLATE_MINERU_DEPLOY_BACKEND=hybrid-engine
# Hybrid 解析强度：medium（更快）, high（更高精度并支持图像分析）
# DOCUTRANSLATE_MINERU_DEPLOY_EFFORT=medium
# 解析方法：auto, txt, ocr
# DOCUTRANSLATE_MINERU_DEPLOY_PARSE_METHOD=auto
# 是否启用表格解析
# DOCUTRANSLATE_MINERU_DEPLOY_TABLE_ENABLE=true
# 是否启用公式解析
# DOCUTRANSLATE_MINERU_DEPLOY_FORMULA_ENABLE=true
# 是否启用图片/图表分析（Hybrid medium 会由 MinerU 自动关闭）
# DOCUTRANSLATE_MINERU_DEPLOY_IMAGE_ANALYSIS=true
# 起始页
# DOCUTRANSLATE_MINERU_DEPLOY_START_PAGE_ID=0
# 结束页
# DOCUTRANSLATE_MINERU_DEPLOY_END_PAGE_ID=99999
# Server URL（http-client 后端时使用）
# DOCUTRANSLATE_MINERU_DEPLOY_SERVER_URL=
# MinerU Deploy HTTP 客户端默认分阶段超时（秒）
# DOCUTRANSLATE_MINERU_DEPLOY_CONNECT_TIMEOUT=5
# DOCUTRANSLATE_MINERU_DEPLOY_READ_TIMEOUT=1800
# DOCUTRANSLATE_MINERU_DEPLOY_WRITE_TIMEOUT=300
# DOCUTRANSLATE_MINERU_DEPLOY_POOL_TIMEOUT=1
# MinerU Deploy 文件上传/解析请求分阶段超时（秒，会覆盖上述客户端默认值）
# DOCUTRANSLATE_MINERU_DEPLOY_UPLOAD_CONNECT_TIMEOUT=2000
# DOCUTRANSLATE_MINERU_DEPLOY_UPLOAD_READ_TIMEOUT=2000
# DOCUTRANSLATE_MINERU_DEPLOY_UPLOAD_WRITE_TIMEOUT=2000
# DOCUTRANSLATE_MINERU_DEPLOY_UPLOAD_POOL_TIMEOUT=2000
# MinerU 3.x 异步任务的总等待时间与轮询间隔（秒）
# DOCUTRANSLATE_MINERU_DEPLOY_TASK_TIMEOUT=3600
# DOCUTRANSLATE_MINERU_DEPLOY_POLL_INTERVAL=1

# -----------------------------------------------------------
# Text 工作流配置
# -----------------------------------------------------------
# 插入模式：replace, append, prepend
# DOCUTRANSLATE_INSERT_MODE=replace
# 分隔符
# DOCUTRANSLATE_SEPARATOR=\n
# 分段模式：line, paragraph, none
# DOCUTRANSLATE_SEGMENT_MODE=line

# -----------------------------------------------------------
# 系统配置
# -----------------------------------------------------------
# Web 服务端口
# DOCUTRANSLATE_PORT=8010
# 全局代理开关：作为 system_proxy_enable 的默认值（单次请求仍可覆盖）
# DOCUTRANSLATE_PROXY_ENABLED=false
# 缓存数量
# DOCUTRANSLATE_CACHE_NUM=10
# 跳过模型调用，只做解析与格式导出（如只转换不做翻译）
# DOCUTRANSLATE_SKIP_TRANSLATE=false
# 内存中保留的任务记录上限（<=0 表示不限制），超出后淘汰最旧的已结束任务
# DOCUTRANSLATE_TASK_MAX_COUNT=200
# 启动时清理多久以前残留的 docutranslate_* 临时目录（小时，<=0 表示不清理）
# DOCUTRANSLATE_TEMP_CLEANUP_AGE_HOURS=24
# 单次上传/请求体大小上限（MB，<=0 表示不限制）
# DOCUTRANSLATE_MAX_UPLOAD_MB=512
# 网页"文本翻译"输入框（POST /service/translate/text）的字符数上限（<=0 表示不限制字符数）
# 注意：即使不限制字符数，仍受 DOCUTRANSLATE_MAX_UPLOAD_MB 请求体大小上限约束
# DOCUTRANSLATE_TEXT_INPUT_LIMIT=1000000

# MinerU 4.x 可使用原有 MINERU_DEPLOY_BASE_URL，无需修改调用代码。
# 服务开启 Bearer 认证时，在上方配置 MINERU_DEPLOY_API_KEY 或在前端填写本地服务密钥。
# MINERU_DEPLOY_BACKEND 仍支持所有旧值，也支持 flash/basic/standard/advanced。
# 4.x 的模型地址、语言、公式/表格开关由服务端配置及档位决定。

# 在线 MinerU 任务轮询等待上限（秒），超时结束等待，不重复提交任务
# DOCUTRANSLATE_MINERU_TASK_TIMEOUT=3600
